# ============================================================
# 环境变量模板：复制为 .env 后按需修改
#   cp .env.example .env
# 注意：.env 已加入 .gitignore，不会提交到仓库，不要提交真实密码
# ============================================================

# MySQL root 密码（唯一必须保留的顶层变量）
MYSQL_ROOT_PASSWORD=root

# ---- 三个微服务各自的独立数据库账号（由 db/init.sql 在容器首次启动时创建）----
# user-service → userdb / user / user123
# menu-service → menudb / menu / menu123
# order-service → orderdb / order_user / order123
# 各服务的 DB_URL/DB_USER/DB_PASSWORD 在 compose.yaml 中按服务分别注入，无需在此重复填写。
