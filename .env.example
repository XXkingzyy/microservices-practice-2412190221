# Copy to .env. Fill private values locally; do not commit .env.
MYSQL_ROOT_PASSWORD=replace-local-db-password
NACOS_USERNAME=nacos
NACOS_PASSWORD=replace-initial-admin-password
# Base64 of at least 32 random bytes
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
NACOS_NAMESPACE=
