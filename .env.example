# ============================================================
# 环境变量模板：复制为 .env 后按需修改
#   cp .env.example .env
# 注意：.env 已加入 .gitignore，不会提交到仓库，不要提交真实密码
# ============================================================

# MySQL root 密码
MYSQL_ROOT_PASSWORD=root

# 应用使用的数据库名
MYSQL_DATABASE=course

# 应用连接数据库的用户名（同时是 MYSQL_USER，容器启动时创建）
DB_USER=course

# 应用连接数据库的密码（同时是 MYSQL_PASSWORD）
DB_PASSWORD=course123
